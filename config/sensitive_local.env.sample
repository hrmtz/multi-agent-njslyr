# Local-only sensitive configuration
# Copy to config/sensitive_local.env and fill in your values.
# sensitive_local.env is NOT tracked by git (whitelist .gitignore).

# Tailscale hostnames (used by cross-machine sync)
KYOTO_HOST=your-kyoto-tailscale-hostname
NEOSAITAMA_HOST=your-neosaitama-tailscale-hostname

# Tailscale IPs (used by NAS access, surgery-log integration, etc.)
NAS_TAILSCALE_IP=100.x.x.x
NAS_PORT=18080
